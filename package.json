{
  "name": "@resolvingarchitecture/http",
  "version": "0.1.0",
  "description": "A plain HTTP/HTTPS client for the RA / 1M5 ecosystem (Envelope in, Envelope out)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "http",
    "https",
    "network",
    "1m5",
    "resolving-architecture"
  ],
  "author": "Brian Taylor <brian@resolvingarchitecture.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolvingarchitecture/http-ts.git"
  },
  "homepage": "https://resolvingarchitecture.dev",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resolvingarchitecture/ra-common": "file:../../common/ra-common-ts",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
